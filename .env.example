# M-SAL2.0 environment variables
# Copy to .env and fill in. .env is in .gitignore and must never be committed.
# Format: NAME=value  (no quotes, no spaces around =)

# ── Supabase project (not secret) ─────────────────────────────
SUPABASE_PROJECT_REF=bzdzveckpxmmdoqcfewv
SUPABASE_URL=https://bzdzveckpxmmdoqcfewv.supabase.co

# Publishable key (public, used by Angular for sign-in only)
# Supabase: Project Settings > API Keys > Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# ── Supabase secrets ──────────────────────────────────────────
# Secret key (server only: invitations through the Auth Admin API)
# Supabase: Project Settings > API Keys > Secret keys (sb_secret_...)
SUPABASE_SECRET_KEY=

# Personal access token for the Supabase CLI (account-wide; revoke after setup)
# Supabase: Account (avatar) > Access Tokens > Generate new token
SUPABASE_ACCESS_TOKEN=

# Database (Spring Boot + Flyway), Session pooler
# Supabase: Connect (top bar) > Method: Session pooler > copy the host
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.bzdzveckpxmmdoqcfewv
SUPABASE_DB_PASSWORD=

# ── Local development database (Docker, not secret) ───────────
LOCAL_DB_NAME=msal
LOCAL_DB_USER=msal
LOCAL_DB_PASSWORD=msal_local
# Host port (5432 is taken by a Windows Postgres on this machine)
LOCAL_DB_PORT=5433

# ── App ───────────────────────────────────────────────────────
# Your own email: the first sign-in with it becomes ADMIN (API.md 2.5)
MSAL_BOOTSTRAP_ADMIN_EMAIL=

# ── Notifications (Web Push, phase 7) ─────────────────────────
# Made by: node scripts/generate-vapid-keys.mjs (writes them here, prints nothing secret)
# The public key is not secret; the private key is. Changing them unsubscribes every device.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who sends: the app's real address (Apple refuses a made-up mailto: with 403 BadJwtToken)
VAPID_SUBJECT=https://abdullahaltaher.github.io/M-SAL2.0/

# ── Later phases (leave empty for now) ────────────────────────
# Phase 8 (Render): set in the service's Environment tab, not here
# Phase 10 (email for sign-in codes, e.g. Resend or Brevo)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
